# ---- Node.js / npm ----
node_modules/
npm-debug.log*
.npm/

# ---- Vite / React build output ----
dist/
dist-ssr/
*.local
.vite/

# ---- Test / coverage output ----
coverage/
test-results/
playwright-report/
playwright/.cache/
*.lcov

# ---- Rust / Tauri ----
target/
src-tauri/target/
src-tauri/gen/schemas/
# Regenerated by tauri-build from the app manifest in build.rs on every build.
src-tauri/permissions/autogenerated/
**/*.rs.bk

# ---- Logs ----
logs/
*.log

# ---- Secrets / environment ----
.env
.env.*
!.env.example

# ---- Local development tooling settings and worktrees ----
/.claude/

# ---- Local design notes (working documents, not published) ----
/docs/

# ---- IDE ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Temporary files ----
*.tmp
*.dawn-tmp
tmp/
