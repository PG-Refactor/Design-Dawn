{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only the application's own commands; no core plugin permissions so the webview cannot listen to Tauri's built-in events (drag-drop paths) or resolve OS paths",
  "windows": ["main", "window-*"],
  "permissions": [
    "allow-select-project-folder",
    "allow-ai-access-overview",
    "allow-set-ai-write-access",
    "allow-remove-ai-project",
    "allow-select-image-files",
    "allow-default-project-location",
    "allow-set-default-project-location",
    "allow-create-project",
    "allow-open-project",
    "allow-reload-project",
    "allow-save-project",
    "allow-create-folder",
    "allow-save-folder",
    "allow-move-entry",
    "allow-delete-folder",
    "allow-create-document",
    "allow-load-document",
    "allow-close-document",
    "allow-save-document",
    "allow-create-sheet",
    "allow-save-sheet",
    "allow-create-block-content",
    "allow-read-block-content",
    "allow-write-block-content",
    "allow-delete-block-content",
    "allow-restore-block-content",
    "allow-delete-sheet",
    "allow-delete-document",
    "allow-get-app-settings",
    "allow-set-theme-preference",
    "allow-set-language-preference",
    "allow-set-text-size",
    "allow-set-auto-save",
    "allow-set-project-tree-width",
    "allow-get-sheet-viewport",
    "allow-save-sheet-viewport",
    "allow-import-dropped-images",
    "allow-copy-asset-to-document",
    "allow-subscribe-drop-notifications",
    "allow-subscribe-close-requests",
    "allow-confirm-window-close",
    "allow-take-open-request",
    "allow-close-project",
    "allow-subscribe-app-requests",
    "allow-ack-open-request",
    "allow-open-project-in-new-window",
    "allow-transfer-document",
    "allow-take-document-transfer",
    "allow-get-project-snapshot",
    "allow-list-project-windows",
    "allow-project-window-at",
    "allow-show-project-in-title",
    "allow-git-status",
    "allow-git-stage",
    "allow-git-unstage",
    "allow-git-discard-impact",
    "allow-git-discard",
    "allow-git-diff",
    "allow-git-commit",
    "allow-git-undo-last-commit",
    "allow-git-history",
    "allow-git-fetch",
    "allow-git-pull",
    "allow-git-push",
    "allow-git-publish",
    "allow-git-remotes",
    "allow-check-external-changes",
    "allow-accept-disk-state",
    "allow-compare-block-content",
    "allow-repair-load-issue",
    "allow-update-outdated-files"
  ]
}
