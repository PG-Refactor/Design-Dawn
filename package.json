{
  "name": "design-dawn",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test": "vitest run",
    "tauri": "tauri",
    "rust:fmt:check": "cargo fmt --check --manifest-path src-tauri/Cargo.toml",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "licenses:generate": "node scripts/third-party-notices.mjs generate",
    "licenses:check": "node scripts/third-party-notices.mjs check",
    "verify": "npm run typecheck && npm run check && npm run test && npm run licenses:check && npm run rust:fmt:check && npm run rust:lint && npm run rust:test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0",
    "dompurify": "3.4.16",
    "markdown-it": "15.0.2",
    "mermaid": "12.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tauri-apps/cli": "2.12.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/markdown-it": "14.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
