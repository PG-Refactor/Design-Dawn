{
  "fixtureVersion": 1,
  "targetsNote": "A case without `targets` runs on both sides. `rust` marks requests the typed TypeScript client cannot produce (invalid ids, paths, names or payloads are rejected by its parsers before any call) or that bypass the client entirely (missing or wrong-typed arguments, ACL).",
  "description": "Real command-boundary contract (docs/testing.md). Rust runs it through Tauri IPC (src-tauri/tests/ipc_contract.rs); TypeScript checks the same request/response shapes against the client wrappers (src/infrastructure/tauri/ipc-contract.test.ts). Cases run in order within a scenario against one app instance.",
  "selectionIdPlaceholder": "$selectionId",
  "scenarios": [
    {
      "name": "open-and-edit-existing-project",
      "description": "Select the project folder copy, open it, then exercise read, write and error paths against it.",
      "folderPicker": ["projectCopy"],
      "cases": [
        {
          "name": "select folder: selected",
          "request": {
            "command": "select_project_folder",
            "args": {}
          },
          "expected": {
            "ok": {
              "status": "selected",
              "selectionId": "$selectionId",
              "displayPath": ""
            }
          },
          "ignoreValuePaths": ["displayPath"]
        },
        {
          "name": "open_project: missing selectionId",
          "targets": ["rust"],
          "request": {
            "command": "open_project",
            "args": {}
          },
          "expected": {
            "tauriError": true
          }
        },
        {
          "name": "open_project: wrong-typed selectionId",
          "targets": ["rust"],
          "request": {
            "command": "open_project",
            "args": {
              "selectionId": 5
            }
          },
          "expected": {
            "tauriError": true
          }
        },
        {
          "name": "open_project: unknown selectionId",
          "request": {
            "command": "open_project",
            "args": {
              "selectionId": "01928f3a-ffff-7fff-bfff-ffffffffffff"
            }
          },
          "expected": {
            "error": {
              "kind": "invalidFolderSelection"
            }
          }
        },
        {
          "name": "open_project: valid selectionId returns the project snapshot",
          "request": {
            "command": "open_project",
            "args": {
              "selectionId": "$selectionId"
