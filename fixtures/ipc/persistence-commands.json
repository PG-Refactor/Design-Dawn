    {
      "name": "empty-directory",
      "description": "The selected folder is empty, so open fails and create succeeds with the same selection.",
      "folderPicker": ["emptyDirectory"],
      "cases": [
        {
          "name": "select folder: selected",
          "request": {
            "command": "select_project_folder",
            "args": {}
          },
          "expected": {
            "ok": {
              "status": "selected",
              "selectionId": "$selectionId",
              "displayPath": ""
