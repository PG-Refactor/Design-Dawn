          },
          "ignoreValuePaths": ["displayPath"]
        },
        {
          "name": "open_project: empty directory has no project.json",
          "request": {
            "command": "open_project",
            "args": {
              "selectionId": "$selectionId"
            }
          },
          "expected": {
            "error": {
              "kind": "fileNotFound"
            }
          }
