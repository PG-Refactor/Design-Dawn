{
  "fixtureVersion": 1,
  "subject": "schemaVersion",
  "description": "schemaVersion must be an integer >= 1 (invalidSchemaVersion) and not newer than the supported version, currently 2 for project (1 is the legacy documentOrder format that is still read) and 1 for folder, document and sheet (unsupportedSchemaVersion). See docs/data-model.md §11.6.",
  "cases": [
    {
      "name": "project current",
      "input": {
        "entity": "project",
        "value": 2
      },
      "expected": {
        "result": "accept"
      }
    },
    {
      "name": "project legacy",
      "input": {
        "entity": "project",
        "value": 1
      },
      "expected": {
        "result": "accept"
      }
    },
    {
      "name": "document current",
      "input": {
        "entity": "document",
        "value": 1
      },
      "expected": {
        "result": "accept"
      }
    },
    {
      "name": "sheet current",
      "input": {
        "entity": "sheet",
        "value": 1
      },
      "expected": {
        "result": "accept"
      }
    },
    {
      "name": "project newer",
      "input": {
        "entity": "project",
        "value": 3
      },
      "expected": {
        "result": "reject",
        "errorKind": "unsupportedSchemaVersion"
      }
    },
    {
      "name": "sheet far newer",
      "input": {
        "entity": "sheet",
        "value": 999
      },
      "expected": {
        "result": "reject",
        "errorKind": "unsupportedSchemaVersion"
      }
    },
    {
      "name": "zero",
      "input": {
        "entity": "document",
        "value": 0
      },
      "expected": {
        "result": "reject",
        "errorKind": "invalidSchemaVersion"
      }
    },
    {
      "name": "negative",
      "input": {
        "entity": "sheet",
        "value": -1
      },
      "expected": {
        "result": "reject",
        "errorKind": "invalidSchemaVersion"
      }
    },
    {
      "name": "fractional",
      "input": {
        "entity": "project",
        "value": 1.5
      },
      "expected": {
        "result": "reject",
        "errorKind": "invalidSchemaVersion"
      },
      "note": "Rust checks this at the JSON DTO -> domain boundary (Rust domain constructors take integers only)."
    },
    {
      "name": "folder current",
      "input": {
        "entity": "folder",
        "value": 1
      },
      "expected": {
        "result": "accept"
      }
    },
    {
      "name": "folder newer",
      "input": {
        "entity": "folder",
        "value": 2
      },
      "expected": {
        "result": "reject",
        "errorKind": "unsupportedSchemaVersion"
      }
    }
  ]
}
