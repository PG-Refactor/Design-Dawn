{
  "fixtureVersion": 1,
  "subject": "displayName",
  "description": "Display names: reject empty, whitespace-only (Unicode White_Space), control characters (U+0000-U+001F, U+007F-U+009F, U+2028, U+2029) and more than 200 code points. Leading/trailing whitespace is not trimmed by the domain. See docs/data-model.md §11.2.",
  "cases": [
    {
      "name": "ascii",
      "input": "System Design",
      "expected": { "result": "accept" }
    },
    {
      "name": "japanese",
      "input": "システム設計",
      "expected": { "result": "accept" }
    },
    {
      "name": "single character",
      "input": "a",
      "expected": { "result": "accept" }
    },
    {
      "name": "emoji (astral plane, 1 code point)",
      "input": "🚀 Launch",
      "expected": { "result": "accept" }
    },
    {
      "name": "leading and trailing spaces are kept",
      "input": "  Overview  ",
      "expected": { "result": "accept" }
    },
    {
      "name": "exactly 200 code points",
      "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "expected": { "result": "accept" }
    },
    {
      "name": "200 astral code points (400 UTF-16 units)",
      "input": "😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀",
      "expected": { "result": "accept" }
    },
    {
      "name": "201 code points",
      "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "expected": { "result": "reject", "errorKind": "invalidDisplayName" }
    },
    {
      "name": "empty",
      "input": "",
      "expected": { "result": "reject", "errorKind": "invalidDisplayName" }
    },
    {
      "name": "spaces only",
      "input": "   ",
      "expected": { "result": "reject", "errorKind": "invalidDisplayName" }
    },
    {
      "name": "ideographic space only (U+3000)",
      "input": "\u3000",
      "expected": { "result": "reject", "errorKind": "invalidDisplayName" }
    },
    {
      "name": "no-break space only (U+00A0)",
      "input": "\u00a0",
      "expected": { "result": "reject", "errorKind": "invalidDisplayName" }
    },
    {
      "name": "tab only",
      "input": "\t",
      "expected": { "result": "reject", "errorKind": "invalidDisplayName" }
    },
    {
      "name": "contains newline",
      "input": "line1\nline2",
      "expected": { "result": "reject", "errorKind": "invalidDisplayName" }
    },
    {
