      "input": "a\u0000b",
      "expected": { "result": "reject", "errorKind": "invalidDisplayName" }
    },
    {
      "name": "contains DEL (U+007F)",
      "input": "a\u007fb",
      "expected": { "result": "reject", "errorKind": "invalidDisplayName" }
    },
    {
      "name": "contains C1 control (U+0085)",
      "input": "a\u0085b",
      "expected": { "result": "reject", "errorKind": "invalidDisplayName" }
    },
    {
      "name": "contains line separator (U+2028)",
      "input": "a\u2028b",
      "expected": { "result": "reject", "errorKind": "invalidDisplayName" }
    },
    {
      "name": "contains paragraph separator (U+2029)",
      "input": "a\u2029b",
      "expected": { "result": "reject", "errorKind": "invalidDisplayName" }
    },
    {
      "name": "zero width space is not White_Space (U+200B)",
      "input": "\u200b",
      "expected": { "result": "accept" },
      "note": "U+200B is not in the Unicode White_Space property and is not a control character."
    }
  ]
