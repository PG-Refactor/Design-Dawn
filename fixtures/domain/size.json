{
  "fixtureVersion": 1,
  "subject": "size",
  "description": "size.width / size.height must be integers from 1 to 2147483647. Block-type minimum sizes are UI constraints, not domain invariants.",
  "cases": [
    {
      "name": "typical",
      "input": {
        "width": 480,
        "height": 320
      },
      "expected": {
        "result": "accept"
      }
    },
    {
      "name": "minimum",
      "input": {
        "width": 1,
        "height": 1
      },
      "expected": {
        "result": "accept"
      }
    },
    {
      "name": "maximum",
      "input": {
        "width": 2147483647,
        "height": 2147483647
      },
      "expected": {
        "result": "accept"
      }
    },
    {
      "name": "zero width",
      "input": {
        "width": 0,
        "height": 100
      },
      "expected": {
        "result": "reject",
        "errorKind": "invalidSize"
      }
    },
    {
      "name": "zero height",
      "input": {
        "width": 100,
        "height": 0
      },
      "expected": {
        "result": "reject",
        "errorKind": "invalidSize"
      }
    },
    {
      "name": "negative width",
      "input": {
        "width": -1,
        "height": 100
      },
      "expected": {
        "result": "reject",
        "errorKind": "invalidSize"
      }
    },
    {
      "name": "height above maximum",
      "input": {
        "width": 100,
        "height": 2147483648
      },
      "expected": {
        "result": "reject",
        "errorKind": "invalidSize"
      }
    },
    {
      "name": "fractional width",
      "input": {
        "width": 10.5,
        "height": 100
      },
      "expected": {
        "result": "reject",
        "errorKind": "invalidSize"
      },
      "note": "Rust checks this at the JSON DTO -> domain boundary (Rust domain constructors take integers only)."
    }
  ]
}
