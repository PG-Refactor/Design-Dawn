      }
    },
    {
      "name": "unknown language",
      "input": "fr",
      "expected": {
        "result": "reject",
        "errorKind": "invalidLanguagePreference"
      }
    },
    {
      "name": "empty",
      "input": "",
      "expected": {
        "result": "reject",
        "errorKind": "invalidLanguagePreference"
      }
    },
    {
